{
  "JSON-text": { "(all)": ["ws", "value", "ws"] },

  "ws": { "(***)": { "(any)": ["x20", "x09", "x0A", "x0D"] } },

  "value": {
    "(any)": ["lit-false", "lit-null", "lit-true", "object", "array", "number", "string"]
  },

  "lit-false": "false",
  "lit-null": "null",
  "lit-true": "true",

  "begin-array": { "(all)": ["ws", "x5B", "ws"] },
  "begin-object": { "(all)": ["ws", "x7B", "ws"] },
  "end-array": { "(all)": ["ws", "x5D", "ws"] },
  "end-object": { "(all)": ["ws", "x7D", "ws"] },
  "name-separator": { "(all)": ["ws", "x3A", "ws"] },
  "value-separator": { "(all)": ["ws", "x2C", "ws"] },

  "object": {
    "(all)": [
      "begin-object",
      { "(???)": { "(all)": ["member", { "(***)": { "(all)": ["value-separator", "member"] } }] } },
      "end-object"
    ]
  },

  "member": { "(all)": ["string", "name-separator", "value"] },

  "array": {
    "(all)": [
      "begin-array",
      { "(???)": { "(all)": ["value", { "(***)": { "(all)": ["value-separator", "value"] } }] } },
      "end-array"
    ]
  },

  "number": {
    "(all)": [{ "(???)": "minus" }, "int", { "(???)": "frac" }, { "(???)": "exp" }]
  },

  "minus": "x2D",
  "plus": "x2B",
  "zero": "x30",
  "decimal-point": "x2E",
  "digit": ["x30", "x39"],
  "digit1-9": ["x31", "x39"],

  "int": { "(any)": ["zero", { "(all)": ["digit1-9", { "(***)": "digit" }] }] },
  "frac": { "(all)": ["decimal-point", { "(+++)": "digit" }] },
  "exp": {
    "(all)": ["exp-marker", { "(???)": { "(any)": ["minus", "plus"] } }, { "(+++)": "digit" }]
  },
  "exp-marker": { "(any)": ["x65", "x45"] },

  "string": { "(all)": ["quotation-mark", { "(***)": "char" }, "quotation-mark"] },
  "quotation-mark": "x22",
  "escape": "x5C",

  "char": { "(any)": ["unescaped", { "(all)": ["escape", "escaped"] }] },

  "escaped": {
    "(any)": [
      "x22",
      "x5C",
      "x2F",
      "x62",
      "x66",
      "x6E",
      "x72",
      "x74",
      { "(all)": ["x75", "hex", "hex", "hex", "hex"] }
    ]
  },

  "hex": { "(any)": [["x30", "x39"], ["x41", "x46"], ["x61", "x66"]] },

  "unescaped": { "(any)": [["x20", "x21"], ["x23", "x5B"], ["x5D", "x10FFFF"]] }
}
